# Database (Vercel Postgres ou Neon - obligatoire)
DATABASE_URL="postgresql://user:password@host:5432/pagaproduction?sslmode=require"

# NextAuth
NEXTAUTH_URL="https://paga-production.vercel.app"
NEXTAUTH_SECRET="generate-a-strong-secret-here"

# Stripe (https://dashboard.stripe.com)
STRIPE_PUBLIC_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Vercel Blob (ajouté automatiquement quand le store est lié)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Local seed only (the route is disabled on Vercel)
SEED_SECRET="generate-a-strong-local-secret"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="generate-a-unique-strong-password"

# Resend (https://resend.com)
RESEND_API_KEY="re_..."
